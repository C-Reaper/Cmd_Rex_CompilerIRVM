# === Makefile.wine ===

CC = x86_64-w64-mingw32-gcc
NASM = nasm
WARNINGS = -Werror
CFLAGS = -O0 -mavx2 -std=gnu17 $(WARNINGS)
INCLUDES = -Isrc -D_WINE
LDFLAGS = -lm
ALXWINDOW_INCLUDE ?= /home/codeleaded/System/Static/Library
SRC_DIR = ./src
BUILD_DIR = ./build
TARGET = $(BUILD_DIR)/Main.exe

all: 
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) ./$(SRC_DIR)/Main.c -o ./$(TARGET) $(LDFLAGS) 

alldebug: 
	$(CC) -g $(CFLAGS) $(INCLUDES) ./$(SRC_DIR)/Main.c -o ./$(TARGET) $(LDFLAGS) 

debug:
	WINEPREFIX=~/wine64 WINEARCH=win64 winedbg $(TARGET)

exe: $(TARGET)
	WINEPREFIX=~/wine64 WINEARCH=win64 wine $(TARGET)

comp:
	echo "Compiler Target Platform is Linux!"

comp_64_Win: all
	mkdir -p ./build
	WINEPREFIX=~/wine64 WINEARCH=win64 wine ./$(TARGET) windows
	$(NASM) -f win64 -g -F cv8 ./asm/Output.asm -o ./build/Program.o
	$(NASM) -f win64 -g -F cv8 ./linker/x64/Win/Syscall.asm -o ./build/Syscall.o
	$(NASM) -f win64 -g -F cv8 ./linker/x64/Win/AlxWindow.asm -o ./build/AlxWindowWrapper.o
	$(CC) -O0 -mavx2 -std=gnu17 -I$(ALXWINDOW_INCLUDE) -c ./linker/alx/AlxWindow.c -o ./build/AlxWindow.o
	$(CC) -Wl,--subsystem,console ./build/Program.o ./build/Syscall.o ./build/AlxWindowWrapper.o ./build/AlxWindow.o -lkernel32 -lntdll -luser32 -lgdi32 -lwinmm -lole32 -loleaut32 -lwindowscodecs -lm -o ./build/Output.exe
	WINEPREFIX=~/wine64 WINEARCH=win64 wine ./build/Output.exe; echo $$?

clean:
	rm -f $(BUILD_DIR)/*

dg: clean alldebug debug

do: clean all exe

# === Makefile.wine ===