define @f.Human.init ptr i64
    ass ptr %0 &0 
    add ptr %1 %0 0 
    store i64 %1 &1 
    ret 

define @f.Human.delete ptr i64
    ass ptr %0 &0 
    add ptr %1 %0 0 
    load i64 %2 %1 
    sub i64 %3 %2 &1 
    store i64 %1 %3 
    ret 

define i64 @f.Human.new i64
    allocs 8 %h 
    ass ptr %2 %h 
    ass ptr %1 %2 
    ass i64 %3 &1 
    call @f.Human.init %1 %3 
    ass ptr %4 %h 
    add i64 %5 %4 0 
    load i64 %6 %5 
    destroy %h 
    ret %6 
    destroy %h 
    ret 

global i64 @f.main
    allocs 8 %a 
    ass i64 %1 20 
    call @f.Human.new %0 %1 
    ass ptr %2 %a 
    add i64 %3 %2 0 
    store i64 %3 %0 
    ass ptr %6 %a 
    ass ptr %5 %6 
    ass i64 %7 10 
    call @f.Human.delete %5 %7 
    ass ptr %10 %a 
    ass ptr %9 %10 
    ass i64 %11 5 
    call @f.Human.delete %9 %11 
    add ptr %12 %a 0 
    load i64 %13 %12 
    add i64 %14 1 %13 
    ass i64 %15 %14 
    destroy %a 
    ret %15 
    destroy %a 
    ret 

