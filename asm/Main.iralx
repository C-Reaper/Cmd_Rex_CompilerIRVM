data i8 &cstr.0 'H' 'e' 'l' 'l' 'o' ' ' 'W' 'o' 'r' 'l' 'd' 10 0

extern @f.syscall i64 i64 i64 i64 i64 i64

define @f.read i64 ptr i64
    ass i64 %1 0 
    ass i64 %2 &0 
    ass i64 %4 &1 
    ass i64 %3 %4 
    ass i64 %5 &2 
    ass i64 %6 0 
    ass i64 %7 0 
    call @f.syscall %1 %2 %3 %5 %6 %7 
    ret 

define @f.write i64 ptr i64
    ass i64 %1 1 
    ass i64 %2 &0 
    ass i64 %4 &1 
    ass i64 %3 %4 
    ass i64 %5 &2 
    ass i64 %6 0 
    ass i64 %7 0 
    call @f.syscall %1 %2 %3 %5 %6 %7 
    ret 

define @f.open i64 i64 i64
    ass i64 %1 2 
    ass i64 %2 &0 
    ass i64 %3 &1 
    ass i64 %4 &2 
    ass i64 %5 0 
    ass i64 %6 0 
    call @f.syscall %1 %2 %3 %4 %5 %6 
    ret 

define @f.close i64
    ass i64 %1 3 
    ass i64 %2 &0 
    ass i64 %3 0 
    ass i64 %4 0 
    ass i64 %5 0 
    ass i64 %6 0 
    call @f.syscall %1 %2 %3 %4 %5 %6 
    ret 

define @f.exit i64
    ass i64 %1 60 
    ass i64 %2 &0 
    ass i64 %3 0 
    ass i64 %4 0 
    ass i64 %5 0 
    ass i64 %6 0 
    call @f.syscall %1 %2 %3 %4 %5 %6 
    ret 

global i64 @f.main
    alloca i64 %v 
    store i64 %v 0 
    alloca ptr %pv 
    ass ptr %0 %v 
    store ptr %pv %0 
    alloca ptr %wow 
    store ptr %wow 0 
    ass i64 %2 1 
    ass ptr %3 &cstr.0 
    ass i64 %4 12 
    call @f.write %2 %3 %4 
    ass i64 %5 0 
    destroy %wow 
    destroy %pv 
    destroy %v 
    ret %5 
    destroy %wow 
    destroy %pv 
    destroy %v 
    ret 

