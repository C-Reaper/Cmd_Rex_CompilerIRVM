# === Makefile.linux ===

CC = gcc
WARNINGS = -Werror
CFLAGS = -g -O0 -mavx2 -std=gnu17 $(WARNINGS)
INCLUDES = -Isrc
LDFLAGS = -lm

SRC_DIR = src
BUILD_DIR = build
CODE_DIR = code

TARGET = $(BUILD_DIR)/Main

all: 
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) ./$(SRC_DIR)/Main.c -o ./$(TARGET) $(LDFLAGS) 

alldebug:
# -fsanitize=address 
	$(CC) -g $(CFLAGS) $(INCLUDES) ./$(SRC_DIR)/Main.c -o ./$(TARGET) $(LDFLAGS) 

debug:
	gdb ./$(TARGET)

exe:
	./$(TARGET)

clean:
	rm -rf $(BUILD_DIR)/*

comp_86_Linux:
	mkdir -p ./build
	nasm -f elf32 -g -F dwarf ./asm/Output.asm -o ./build/Program.o
	nasm -f elf32 -g -F dwarf ./linker/x86/Linux.asm -o ./build/Entry.o
	ld -m elf_i386 -no-pie ./build/Program.o ./build/Entry.o -o ./build/Output
	./build/Output; echo $$?

comp_64_Linux:
	mkdir -p ./build
	nasm -f elf64 -g -F dwarf ./asm/Output.asm -o ./build/Program.o
	nasm -f elf64 -g -F dwarf ./linker/x64/Linux.asm -o ./build/Entry.o
	ld -m elf_x86_64 -no-pie ./build/Program.o ./build/Entry.o -o ./build/Output
	./build/Output; echo $$?

comp_86_Win:
	mkdir -p ./build
	nasm -f win32 -g -F cv8 ./asm/Output.asm -o ./build/Program.o
	nasm -f win32 -g -F cv8 ./linker/x86/Win.asm -o ./build/Entry.o
	i686-w64-mingw32-gcc -nostdlib -Wl,-e,_start -Wl,--subsystem,console ./build/Program.o ./build/Entry.o -lkernel32 -o ./build/Output.exe
	wine ./build/Output.exe; echo $$?

comp_64_Win:
	mkdir -p ./build
	nasm -f win64 -g -F cv8 ./asm/Output.asm -o ./build/Program.o
	nasm -f win64 -g -F cv8 ./linker/x64/Win.asm -o ./build/Entry.o
	x86_64-w64-mingw32-gcc -nostdlib -Wl,-e,_start -Wl,--subsystem,console ./build/Program.o ./build/Entry.o -lkernel32 -lntdll -o ./build/Output.exe
	wine ./build/Output.exe; echo $$?

do: clean all exe

dg: clean alldebug debug

# === Makefile.linux ===